<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitness.controller.MainController"
            styleClass="root">

    <left>

        <VBox prefWidth="240"
              spacing="8"
              styleClass="sidebar">

            <Label text="FITNESS"
                   styleClass="logo"/>

            <Label text="УДИРДЛАГЫН СИСТЕМ"
                   styleClass="sidebar-subtitle"/>

            <Button text="Хяналтын самбар"
                    onAction="#showDashboard"
                    styleClass="menu-button"/>

            <Button text="Гишүүд"
                    onAction="#showMembers"
                    styleClass="menu-button"/>

            <Button text="Гишүүнчлэл"
                    onAction="#showMemberships"
                    styleClass="menu-button"/>

            <Button text="Дасгалжуулагч"
                    onAction="#showCoaches"
                    styleClass="menu-button"/>

            <Button text="Хичээлийн хуваарь"
                    onAction="#showClasses"
                    styleClass="menu-button"/>

            <Button text="Бүртгэл"
                    onAction="#showBookings"
                    styleClass="menu-button"/>

            <Button text="Төлбөр"
                    onAction="#showPayments"
                    styleClass="menu-button"/>

            <Button text="Ирц"
                    onAction="#showAttendance"
                    styleClass="menu-button"/>

            <VBox VBox.vgrow="ALWAYS"/>

            <Label text="Java 21 • JavaFX 21"
                   styleClass="version-label"/>

            <Label text="Түр өгөгдлийн горим"
                   styleClass="version-label"/>

        </VBox>

    </left>

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    styleClass="content-scroll">

            <StackPane fx:id="contentArea"
                       styleClass="content-area"/>

        </ScrollPane>

    </center>

</BorderPane>